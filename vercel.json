{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/landing.html", "destination": "/landing.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!landing|landing-assets|_expo|assets|sw.js|manifest.json|favicon.ico|robots.txt|.*\\..*).*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}