{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/login(.*)", "destination": "/index.html" },
    { "source": "/signup(.*)", "destination": "/index.html" },
    { "source": "/otp(.*)", "destination": "/index.html" },
    { "source": "/pin(.*)", "destination": "/index.html" },
    { "source": "/pin-setup(.*)", "destination": "/index.html" },
    { "source": "/dashboard(.*)", "destination": "/index.html" },
    { "source": "/(app)(.*)", "destination": "/index.html" },
    { "source": "/privacy(.*)", "destination": "/index.html" },
    { "source": "/terms(.*)", "destination": "/index.html" }
  ]
}